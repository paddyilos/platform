## Laravel
APP_ENV=local
APP_DEBUG=true
APP_KEY=SomeRandomKey!!!SomeRandomKey!!!
APP_TIMEZONE=UTC
# Public base URL of this backend — used to build absolute links (e.g. the
# Get Alerts unsubscribe link) from background/queued code with no request
# context. Leave unset locally; set to the real backend URL in production.
APP_URL=

DEFAULT_CLIENT_URL=

## Mail (password reset + Get Alerts notification emails read these;
## config/mail.php falls back to a placeholder Mailgun host with no
## credentials if left unset, so nothing will actually send until this
## is filled in for a real deployment)
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
# MAIL_DRIVER=log writes rendered emails to storage/logs/laravel.log instead
# of sending — useful for local dev without real SMTP credentials.

DB_CONNECTION=mysql
DB_HOST=192.168.33.110
DB_HOST_REPLICA=192.168.33.110
DB_PORT=3306
DB_DATABASE=ushahidi
DB_USERNAME=homestead
DB_PASSWORD=secret
DB_SOCKET=

CACHE_DRIVER=memcached
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
HDX_URL=https://test-data.humdata.org

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

MAINTENANCE_MODE=0
